{
  "name": "greenly",
  "version": "1.1.4",
  "description": "Config-driven project check runner. Define your lint/format/typecheck/test/custom steps in greenly.config.ts and run them with one command.",
  "keywords": [
    "autofix",
    "build",
    "check",
    "check-runner",
    "checks",
    "ci",
    "ci-checks",
    "cli",
    "code-quality",
    "config",
    "defineconfig",
    "eslint",
    "format",
    "git-hooks",
    "lint",
    "linter",
    "local-ci",
    "monorepo",
    "npm-scripts",
    "oxfmt",
    "oxlint",
    "pipeline",
    "pr-checks",
    "pre-commit",
    "pre-push",
    "prettier",
    "quality",
    "task-runner",
    "test",
    "tsc",
    "typecheck",
    "typescript",
    "validate",
    "verify",
    "vitest",
    "workflow"
  ],
  "homepage": "https://github.com/yusifaliyevpro/greenly#readme",
  "bugs": {
    "url": "https://github.com/yusifaliyevpro/greenly/issues"
  },
  "license": "LGPL-2.1-or-later",
  "author": {
    "name": "Yusif Aliyev",
    "email": "yusifaliyevpro@gmail.com",
    "url": "https://yusifaliyevpro.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusifaliyevpro/greenly.git"
  },
  "funding": [
    {
      "type": "patreon",
      "url": "https://patreon.com/yusifaliyevpro"
    },
    {
      "type": "kofe.al",
      "url": "https://kofe.al/@yusifaliyevpro"
    }
  ],
  "bin": {
    "greenly": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "jiti": "2.7.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=18"
  }
}
